# Everything construct, the operator and Claude's usual tools need on a Mac.
# Used by bootstrap-mac.sh (brew bundle). Safe to re-run.

brew "tmux"       # construct session, operator and worker windows
brew "gh"         # GitHub CLI; also the git credential helper (https)
brew "uv"         # uvx runs the UniFi MCP server and other Python tools
brew "poppler"    # pdftotext etc. for reading PDFs
brew "neovim"     # editor pane (LazyVim, set up by install.sh)
brew "ripgrep"
brew "fd"
brew "lazygit"

cask "android-platform-tools"          # adb, for the TV at 192.168.50.59
cask "font-jetbrains-mono-nerd-font"   # icons in tmux and LazyVim

# Not needed for the AI role, add if wanted on this Mac:
# cask "raspberry-pi-imager"
